<script>
    (function () {
        var translations = {
            et: {
                title: "RIA DigiDoc rakendust ei leitud – id.eesti.ee",
                metaDescription: "RIA DigiDoc rakendust ei leitud või vajab uuendamist. Paigalda või uuenda rakendus App Store'ist või Google Play poest.",
                logoAria: "id.ee avaleht",
                heading: "RIA DigiDoc rakendust ei leitud või vajab uuendamist",
                intro: "Valisid e-teenuses autentimiseks või allkirjastamiseks ID-kaardi NFC lahenduse, kuid sinu seadmes ei leitud RIA DigiDoc mobiilirakendust või see vajab uuendamist. Toimingu lõpuleviimiseks paigalda või uuenda rakendus ja alusta seejärel uuesti.",
                storeNavAria: "Rakenduse allalaadimine",
                appStoreAria: "Laadi alla App Store'ist",
                googlePlayAria: "Hangi teenusest Google Play",
                stepsHeading: "Kuidas jätkata?",
                step1: "Veendu, et kasutad RIA DigiDoci rakenduse uusimat versiooni. Vajadusel paigalda või uuenda rakendus App Store'ist või Google Play poest.",
                step2: "Veendu, et sinu seade toetab NFC-d ja NFC on seadme seadetes sisse lülitatud.",
                step3: "Naase e-teenusesse ja alusta autentimist või allkirjastamist uuesti.",
                articlesHeading: "Loe lähemalt RIA DigiDoc rakenduse ja NFC kohta",
                articleNfc: "Mis on NFC?",
                articleApp: "RIA DigiDoc mobiilirakendus",
                articleFaq: "NFC korduma kippuvad küsimused",
                articleSupport: "Võta ühendust RIA kasutajatoega",
                footerLogoAria: "Riigi Infosüsteemi Amet"
            },
            en: {
                title: "RIA DigiDoc app not found – id.eesti.ee",
                metaDescription: "The RIA DigiDoc app was not found or needs updating. Install or update the app from the App Store or Google Play.",
                logoAria: "id.ee homepage",
                heading: "RIA DigiDoc app was not found or needs updating",
                intro: "You chose the ID-card NFC solution for authentication or signing in an e-service, but the RIA DigiDoc mobile app was not found on your device or it needs updating. To complete the action, install or update the app and then start again.",
                storeNavAria: "Download the app",
                appStoreAria: "Download on the App Store",
                googlePlayAria: "Get it on Google Play",
                stepsHeading: "How to continue?",
                step1: "Make sure you are using the latest version of the RIA DigiDoc app. If necessary, install or update the app from the App Store or Google Play.",
                step2: "Make sure your device supports NFC and that NFC is turned on in your device settings.",
                step3: "Return to the e-service and start authentication or signing again.",
                articlesHeading: "Read more about the RIA DigiDoc app and NFC",
                articleNfc: "What is NFC?",
                articleApp: "RIA DigiDoc mobile app",
                articleFaq: "NFC frequently asked questions",
                articleSupport: "Contact RIA user support",
                footerLogoAria: "Information System Authority"
            }
        };

        var toggle = document.getElementById("lang-toggle");
        var current = "et";

        function setLang(lang) {
            var dict = translations[lang];
            current = lang;
            document.documentElement.lang = lang;
            document.title = dict.title;
            document.querySelector('meta[name="description"]').setAttribute("content", dict.metaDescription);
            document.querySelectorAll("[data-i18n]").forEach(function (el) {
                el.textContent = dict[el.getAttribute("data-i18n")];
            });
            document.querySelectorAll("[data-i18n-aria]").forEach(function (el) {
                el.setAttribute("aria-label", dict[el.getAttribute("data-i18n-aria")]);
            });
            var other = lang === "et" ? "en" : "et";
            toggle.textContent = other === "en" ? "English" : "Eesti";
            toggle.setAttribute("lang", other);
            toggle.setAttribute("hreflang", other);
            toggle.setAttribute("href", "?lang=" + other);
        }

        toggle.addEventListener("click", function (event) {
            event.preventDefault();
            var next = current === "et" ? "en" : "et";
            setLang(next);
            if (history.replaceState) {
                history.replaceState(null, "", "?lang=" + next);
            }
        });

        if (new URLSearchParams(location.search).get("lang") === "en") {
            setLang("en");
        }
    })();
</script>
</body>
</html>
